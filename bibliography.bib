@article{bruner2004,
	author = {R. Bruner and R. Conroy and W.Li},
	date-added = {2021-03-03 19:27:19 -0500},
	date-modified = {2021-03-03 19:27:19 -0500},
	journal = {preprint},
	note = {The relative importance of country factors, sector factors and industry factors in explaining stock returns of individual firms in developed market economies has received considerable attention. In this study we turn attention to the influence of these factors on the equity returns in emerging markets economies. This is timely because of the resurgent interest in emerging markets equities and because these equities offer a more acute perspective on the countries-versus-sectors debate. The findings of this study shed light on whether the globalization of capital markets extends to emerging economies. Our results show that in respect to emerging markets equities, the country factor strongly dominates sector and industry. The evidence suggests that diversification across emerging countries has provided greater risk reduction for emerging markets equity portfolios than diversification by industries during the past decade. It also suggests that country allocation will likely remain an important consideration for active managers of emerging markets equity portfolios.},
	title = {The relative importance of country and industry factors in emerging markets},
	year = {2004}
}

